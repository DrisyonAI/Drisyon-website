# Website email (server-side only — never prefix with NEXT_PUBLIC_).
# Sent through the Hostinger mailbox over SMTP. SMTP_PASS is the mailbox password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=reachus@drisyon.com
SMTP_PASS=
# Where form messages and bookings are delivered (defaults to SMTP_USER)
CONTACT_TO_EMAIL=reachus@drisyon.com

# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://drisyon.com

# Optional social/community links. Leave blank to show "coming soon" placeholders.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_MEETUP_URL=
NEXT_PUBLIC_COMMUNITY_URL=

# Google Calendar — call bookings (server-side only). When these three are set, bookings are added
# to Google Calendar with a Meet link and invites; busy times are hidden from the slot picker.
# Get the refresh token once with: node scripts/google-auth.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar to book into (default "primary" = the connected account's main calendar)
GOOGLE_CALENDAR_ID=
# Optional per-founder calendars (must be shared with the connected account with "Make changes to events")
GOOGLE_CALENDAR_ID_NARAYANAMURTHY=
GOOGLE_CALENDAR_ID_MADHURA_REDDY=
# Optional: founders' own addresses, invited to each of their bookings
FOUNDER_EMAIL_NARAYANAMURTHY=
FOUNDER_EMAIL_MADHURA_REDDY=

# Optional: founders' own scheduler links (Calendly, Cal.com…). When set, the founder's card opens
# that scheduler instead of the built-in slot picker (which sends a request by email).
NEXT_PUBLIC_BOOKING_URL_NARAYANAMURTHY=
NEXT_PUBLIC_BOOKING_URL_MADHURA_REDDY=

# ── Cloud Security Cohort: online payments (server-side only) ─────────────────────────
# Payments stay OFF (the course page shows an enquiry form) until ALL of these are true:
#   RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET set, COHORT_PAYMENTS=on, and the registered office +
#   grievance officer filled in src/lib/company.ts. Use rzp_test_* keys first, rzp_live_* after KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same secret as the webhook in Razorpay → Webhooks: https://drisyon.com/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
COHORT_PAYMENTS=off
# Course team phone for Call / WhatsApp buttons (+91XXXXXXXXXX). Buttons are hidden until set.
CONTACT_PHONE=
# Enrolment database (table drisyon_enrolments; see supabase/migrations/). Without these, payments
# still work but enrolments are not recorded and the 30-seat cap is not enforced.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
